# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production (production hides internal error details)
APP_ENV=development
HTTP_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (ignored when DATABASE_URL is set)
# ---------------------------------------------------------------------------
# make up               -> bundled Postgres container is created with DB_USER/DB_PASSWORD/DB_NAME
# make up-external-db   -> API container connects to DB_HOST_DOCKER:DB_PORT (your existing Postgres)
# make run              -> API runs on the host and connects to DB_HOST:DB_PORT
DB_HOST=localhost
# Host of the existing Postgres as seen from inside the API container.
# host.docker.internal = Postgres running on your machine.
DB_HOST_DOCKER=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_management
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true
# Connection pool size
DB_MAX_CONNS=10
# Connection attempts at startup (1s, 2s, 3s ... between attempts)
DB_CONNECT_RETRIES=10
# Host port published by the bundled Postgres container
DB_EXPOSE_PORT=5433
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_management?sslmode=disable

# ---------------------------------------------------------------------------
# Auth: random value of at least 32 characters, e.g. `openssl rand -hex 32`.
# `make` replaces this placeholder with a random secret when it creates .env;
# the placeholder itself is rejected when APP_ENV=production.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_TTL=24h
# Requests per minute per client IP on /auth/register and /auth/login (0 disables)
AUTH_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------
IDEMPOTENCY_TTL=24h

# Set to true to make the mock notifier fail and watch the assign transaction roll back
NOTIFIER_SIMULATE_FAILURE=false
